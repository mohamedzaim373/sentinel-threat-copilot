# Copy to .env and fill in your own values — never commit the real .env.

# ── LLM (required) ────────────────────────────────────────────────────────────
# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# ── Wazuh indexer / OpenSearch (required for live alerts) ─────────────────────
# Password for the OpenSearch "admin" user on https://localhost:9200
OPENSEARCH_PASS=your_opensearch_password_here

# ── Threat intelligence enrichment (optional) ─────────────────────────────────
# Each one is optional; enrichment degrades gracefully when a key is missing.
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here
GREYNOISE_API_KEY=your_greynoise_key_here

# ThreatFox and URLHaus need no API key.

# ── Dashboard (optional) ──────────────────────────────────────────────────────
# Where the FastAPI backend is reachable from the Streamlit dashboard.
API_URL=http://localhost:8001
